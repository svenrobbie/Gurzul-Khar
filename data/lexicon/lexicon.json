  "derivationalAffixes": [
    {
      "suffix": "-dûm",
      "function": "agent/characterised-by noun",
      "example": "khar (strength, n) -> khardûm (the mighty one, n)"
    },
    {
      "suffix": "-ith",
      "function": "adjective -> adverb",
      "example": "khar (strong, adj) -> kharith (strongly, adv)"
    },
    {
      "suffix": "-ûl",
      "function": "verb -> place-of-action noun",
      "example": "pâk (to go, v) -> pâkûl (road, n)"
    }
  ],
