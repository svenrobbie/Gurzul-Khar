{
  "name": "gurzul-khar",
  "version": "0.1.0",
  "private": true,
  "description": "GURZÛL KHAR — constructed language engine, data and learning/translation platform.",
  "type": "module",
  "scripts": {
    "dev": "npm run --prefix website dev",
    "build": "npm run build:wasm && npm run --prefix website build",
    "build:wasm": "wasm-pack build crates/gkh-wasm --target web --out-dir pkg",
    "test": "cargo test --workspace",
    "validate": "node scripts/validate.mjs && node scripts/validateLearning.mjs",
    "install:all": "npm install && npm install --prefix website",
    "rust:data": "node scripts/buildRustData.mjs .",
    "fixtures:phonotactics": "node scripts/buildPhonotacticFixture.mjs",
    "coiner:golden": "node scripts/buildCoinerGolden.mjs",
    "coiner:sample": "node scripts/sampleCoinages.mjs > COINER_SAMPLE.md",
    "coiner:index": "node scripts/buildCoinageIndex.mjs",
    "lexicon:ipa": "node scripts/syncLexiconIpa.mjs"
  }
}
