{
  "name": "gurzul-khar",
  "version": "0.1.0",
  "private": true,
  "description": "GURZÛL KHAR — constructed language engine, data and learning/translation platform.",
  "type": "module",
  "scripts": {
    "dev": "npm run --prefix website dev",
    "build": "npm run build:engine && npm run --prefix website build",
    "build:engine": "tsc -p tsconfig.json --noEmit false --outDir dist/engine",
    "test": "vitest run",
    "validate": "tsx tests/validateData.ts",
    "install:all": "npm install && npm install --prefix website",
    "fixtures:phonotactics": "tsx scripts/buildPhonotacticFixture.ts",
    "coiner:weights": "tsx scripts/buildCoinerWeights.ts",
    "coiner:golden": "tsx scripts/buildCoinerGolden.ts",
    "coiner:sample": "tsx scripts/sampleCoinages.ts > COINER_SAMPLE.md",
    "coiner:index": "tsx scripts/buildCoinageIndex.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.11",
    "tsx": "^4.19.1",
    "@types/node": "^22.9.0"
  }
}
